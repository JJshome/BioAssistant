# General
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=biotech_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=biotech_mongo_db
MONGO_URL=mongodb://${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}

# API Keys (Example)
# OPENAI_API_KEY=your_openai_api_key
# PUBMED_API_KEY=your_pubmed_api_key
# SOME_OTHER_SERVICE_API_KEY=your_other_service_api_key

# JWT / Auth
JWT_SECRET=supersecretjwtkey
JWT_EXPIRES_IN=1d

# Services Ports (Defaults)
LITERATURE_SERVICE_PORT=8000
EXPERIMENT_SERVICE_PORT=8001
ANALYSIS_SERVICE_PORT=8002
LAB_INTEGRATION_SERVICE_PORT=3000
COLLABORATION_SERVICE_PORT=3001
COMPLIANCE_SERVICE_PORT=3002
WEB_APP_PORT=3003
ADMIN_APP_PORT=3004
